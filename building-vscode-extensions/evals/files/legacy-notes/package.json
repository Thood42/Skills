{
  "name": "legacy-notes",
  "displayName": "Legacy Notes",
  "description": "Keep quick notes per workspace and sync them to the team notes service.",
  "version": "1.3.0-beta",
  "publisher": "acme-devtools",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": [
    "*",
    "onCommand:legacyNotes.addNote"
  ],
  "contributes": {
    "commands": [
      { "command": "legacyNotes.addNote", "title": "Add Note" },
      { "command": "legacyNotes.showNotes", "title": "Show Notes", "category": "Legacy Notes" },
      { "command": "legacyNotes.exportNotes", "title": "Export Notes", "category": "Legacy Notes" }
    ],
    "configuration": {
      "title": "Legacy Notes",
      "properties": {
        "legacyNotes.serverUrl": {
          "type": "string",
          "description": "Team notes service URL."
        },
        "notesFolder": {
          "type": "string",
          "default": ".notes",
          "description": "Folder for local notes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/node": "20.x",
    "@vscode/test-electron": "^2.4.0",
    "mocha": "^10.4.0"
  }
}
